e = poolWater.Size\n\t\t\tlocal localPos = waterCFrame:PointToObjectSpace(hrp.Position)\n\t\t\t\n\t\t\tlocal inWater = math.abs(localPos.X) < waterSize.X/2\n\t\t\t\t\t\tand math.abs(localPos.Y) < waterSize.Y/2\n\t\t\t\t\t\tand math.abs(localPos.Z) < waterSize.Z/2\n\t\t\t\n\t\t\tlocal humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\tif humanoid then\n\t\t\t\tif inWater and not isSwimming then\n\t\t\t\t\tisSwimming = true\n\t\t\t\t\thumanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)\n\t\t\t\t\thumanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)\n\t\t\t\t\thumanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)\n\t\t\t\t\thumanoid:ChangeState(Enum.HumanoidStateType.Swimming)\n\t\t\t\telseif not inWater and isSwimming then\n\t\t\t\t\tisSwimming = false\n\t\t\t\t\thumanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)\n\t\t\t\t\thumanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)\n\t\t\t\t\thumanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)\n\t\t\t\t\thumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\t\n\t\t-- Run check loop\n\t\ttask.spawn(function()\n\t\t\twhile character and character.Parent do\n\t\t\t\tcheckWater()\n\t\t\t\ttask.wait(0.1)\n\t\t\tend\n\t\tend)\n\tend)\nend\n\n-- Setup for existing players\nfor _, player in Players:GetPlayers() do\n\tsetupSwimming(player)\nend\n\n-- Setup for new players\nPlayers.PlayerAdded:Connect(setupSwimming)\n\n-- Also handle if poolWater is added later\nif not poolWater then\n\ttask.spawn(function()\n\t\twhile not poolWater do\n\t\t\ttask.wait(1)\n\t\t\tlocal pool = game.Workspace:FindFirstChild(\"swimming pool\")\n\t\t\tif pool then\n\t\t\t\tpoolWater = pool:FindFirstChild(\"PoolWater\")\n\t\t\tend\n\t\tend\n\tend)\nend","path":"ServerScrip<<<END>>>  -  Edit
