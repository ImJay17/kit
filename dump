n-- ============================================================\n\nlocal DataStoreService = game:GetService(\"DataStoreService\")\nlocal Players          = game:GetService(\"Players\")\nlocal TimeOrdered = DataStoreService:GetOrderedDataStore(\"TimeSpent_v2\")\nlocal NameStore   = DataStoreService:GetDataStore(\"TimeSpentNames_v1\")\n\nlocal TAG = \"[TimeRestore]\"\n\n-- Helpers so the config below reads naturally.\nlocal function hrs(h, m)\n\treturn (h * 3600) + ((m or 0) * 60)\nend\nlocal function mins(m)\n\treturn m * 60\nend\n\n-- =================================================================\n-- CONFIG: fill in {userId = seconds} for everyone who needs restoring.\n-- Examples below; replace with real values.\n-- =================================================================\nlocal PLAYERS_TO_RESTORE = {\n\t-- [8984270787] = hrs(4),       -- 4 hours\n\t-- [12345678]   = hrs(2, 30),   -- 2h 30m\n\t-- [87654321]   = mins(90),     -- 90 mins\n}\n\nlocal function formatTime(seconds)\n\tlocal h = math.floor(seconds / 3600)\n\tlocal m = math.floor((seconds % 3600) / 60)\n\tif h > 0 then return string.format(\"%dh %dm\", h, m) else return string.format(\"%dm\", m) end\nend\n\n-- Make sure the player's name is stored in NameStore so the leaderboard can\n-- display \"DisplayName (@username)\" instead of falling back to the raw UserId.\nlocal function ensureNameStored(uid)\n\tlocal key = tostring(uid)\n\n\t-- Skip if a name is already saved (don't overwrite an existing entry that\n\t-- might already be in the \"DisplayName (@username)\" format).\n\tlocal okExisting, existing = pcall(function() return NameStore:GetAsync(key) end)\n\tif okExisting and type(existing) == \"string\" and existing ~= \"\" then\n\t\tprint(TAG, \"   name already stored for\", key, \"->\", existing)\n\t\treturn\n\tend\n\n\t-<<<END>>>  -  Edit
